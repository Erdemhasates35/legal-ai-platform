# =====================================================
# Legal AI Platform – Production Environment Variables
# =====================================================

# Supabase (zorunlu)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (Supabase Auth içinde yapılandırılır)
# Google Client ID ve Secret Supabase Dashboard > Authentication > Providers > Google

# Opsiyonel – Embedding / LLM sağlayıcı
OPENAI_API_KEY=

# Vercel (otomatik enjekte edilir)
# VERCEL_URL=
# VERCEL_ENV=

# GitHub Actions secrets (repo Settings > Secrets)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
