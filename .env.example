# =====================================================
# Legal AI Platform – Production Environment Variables
# =====================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# First administrator bootstrap: exact Google account email.
# Leave unset after the initial admin has been created if desired.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Optional provider for future server-side AI workloads.
OPENAI_API_KEY=

# Vercel runtime variables are supplied by the platform.
# VERCEL_URL=
# VERCEL_ENV=

# GitHub Actions deployment secrets.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
